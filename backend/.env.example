APP_NAME="NiCare ODK"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://odk-web.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Africa/Lagos

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_DATABASE=nicare_odk
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=

QUEUE_CONNECTION=sync
CACHE_STORE=file
SESSION_DRIVER=file

BILLING_PROVIDER=paystack
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
ODK_PROFESSIONAL_PRICE=

FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

SANCTUM_STATEFUL_DOMAINS=odk-web.test,localhost:8092,127.0.0.1:8092

NICARE_API_BASE_URL=http://nicare-system.test
NICARE_API_TOKEN=
NICARE_REFERENCE_SYNC_ENABLED=false
NICARE_API_TIMEOUT=30
NICARE_FACILITIES_ENDPOINT=/api/odk/reference/facilities
NICARE_LGAS_ENDPOINT=/api/odk/reference/lgas
NICARE_WARDS_ENDPOINT=/api/odk/reference/wards
NICARE_PREMIUM_METADATA_ENDPOINT=/api/odk/reference/premium-metadata
